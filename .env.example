# Firebase Configuration for Smart Hostel & Mess Administration
# Target Firebase Project: smart-hostel-and-mess

VITE_FIREBASE_API_KEY=your_api_key_from_firebase_console
VITE_FIREBASE_AUTH_DOMAIN=smart-hostel-and-mess.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smart-hostel-and-mess
VITE_FIREBASE_STORAGE_BUCKET=smart-hostel-and-mess.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Institutional Warden Onboarding Secret (Server-side ONLY. Do NOT prefix with VITE_)
WARDEN_INVITE_CODE=CAMPUS-WARDEN-SECURE-2026

# Smart Maintenance AI Gemini Key (Server-side ONLY. Do NOT prefix with VITE_)
GEMINI_API_KEY=your_gemini_api_key

# Demo Mode Flag (Set to true ONLY in local evaluation, false in production)
VITE_DEMO_MODE=false
