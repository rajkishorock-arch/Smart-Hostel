rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isWarden() {
      return isAuthenticated() && 
        (request.auth.token.role == 'warden' || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'warden'));
    }

    // 1. User Profiles Collection
    match /users/{userId} {
      // Unauthenticated users cannot read profiles.
      // Residents can only view their own profile; wardens can view all profiles.
      allow read: if isAuthenticated() && (isOwner(userId) || isWarden());

      // Public registration: Users can only create their OWN document, and role MUST be 'resident'.
      // Public users CANNOT create a document with role == 'warden'.
      allow create: if isAuthenticated() && 
        request.auth.uid == userId &&
        request.resource.data.role == 'resident' &&
        request.resource.data.uid == userId;

      // Profile updates:
      // - Normal user: can update contact details (name, phone, email), but CANNOT change role, UID, roomNumber, bedNumber, block, hostel, or account status.
      // - Warden: authorized to modify administrative fields and room assignments.
      allow update: if isAuthenticated() && 
        (isWarden() || (isOwner(userId) && 
          request.resource.data.role == resource.data.role &&
          request.resource.data.uid == resource.data.uid &&
          (!('roomNumber' in request.resource.data) || request.resource.data.roomNumber == resource.data.roomNumber) &&
          (!('bedNumber' in request.resource.data) || request.resource.data.bedNumber == resource.data.bedNumber) &&
          (!('block' in request.resource.data) || request.resource.data.block == resource.data.block) &&
          (!('hostel' in request.resource.data) || request.resource.data.hostel == resource.data.hostel) &&
          (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)));

      // Only wardens can delete user records
      allow delete: if isWarden();
    }

    // 2. Maintenance Tickets Collection
    match /tickets/{ticketId} {
      // Residents can read only tickets where residentId == auth.uid; wardens can read all tickets
      allow read: if isAuthenticated() && 
        (resource.data.residentId == request.auth.uid || isWarden());
      
      // Residents can create tickets for themselves
      allow create: if isAuthenticated() && 
        request.resource.data.residentId == request.auth.uid;
      
      // Status & Resolution updates:
      // - Wardens have full update access.
      // - Residents can update their own ticket (e.g., adding description or cancelling).
      allow update: if isWarden() || 
        (isAuthenticated() && 
         resource.data.residentId == request.auth.uid && 
         request.resource.data.residentId == resource.data.residentId);
      
      // Only wardens can delete tickets
      allow delete: if isWarden();
    }

    // 3. Mess Menu Collection
    match /mess_menu/{menuDoc} {
      // Any authenticated user can read published mess menu
      allow read: if isAuthenticated();
      // ONLY Wardens can modify or publish mess menu
      allow write: if isWarden();
    }

    // 4. Rooms Collection
    match /rooms/{roomId} {
      // Any authenticated user can read room occupancy
      allow read: if isAuthenticated();
      // ONLY Wardens can allocate or edit rooms
      allow write: if isWarden();
    }

    // 5. Announcements / Notices Collection
    match /announcements/{annId} {
      allow read: if isAuthenticated();
      allow write: if isWarden();
    }

    // 6. Mess Schedule Collection
    match /mess_schedule/{schId} {
      allow read: if isAuthenticated();
      allow write: if isWarden();
    }

    // 7. Notification Center Collection
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.targetRole == 'all' || 
         (resource.data.targetRole == 'warden' && isWarden()));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isWarden());
      allow delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isWarden());
    }

    // 8. Activity / Audit Logs Collection
    match /activity_logs/{logId} {
      allow read: if isAuthenticated() && isWarden();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // 9. Invoices & Billing Collection
    match /invoices/{invId} {
      allow read: if isAuthenticated() && (resource.data.studentUid == request.auth.uid || isWarden());
      allow create, update: if isAuthenticated() && (isWarden() || (resource.data.studentUid == request.auth.uid));
      allow delete: if isWarden();
    }

    // 10. Gate Passes & Student Leave Requests
    match /gate_passes/{passId} {
      allow read: if isAuthenticated() && (resource.data.residentId == request.auth.uid || isWarden());
      allow create: if isAuthenticated() && request.resource.data.residentId == request.auth.uid;
      allow update: if isWarden() || (isAuthenticated() && resource.data.residentId == request.auth.uid);
      allow delete: if isWarden();
    }

    // 11. Night Attendance & Curfew Logs
    match /attendance/{attId} {
      allow read: if isAuthenticated();
      allow write: if isWarden();
    }

    // 12. Room Transfer Requests
    match /room_requests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.residentId == request.auth.uid || isWarden());
      allow create: if isAuthenticated() && request.resource.data.residentId == request.auth.uid;
      allow update: if isWarden();
      allow delete: if isWarden();
    }

    // 13. Default Deny All Other Collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
