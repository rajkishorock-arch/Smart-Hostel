rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if current user matches document user
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user has warden/admin role
    function isWarden() {
      return isAuthenticated() && 
        (request.auth.token.role == 'warden' || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'warden'));
    }

    // User profiles
    match /users/{userId} {
      // Unauthenticated users cannot read profiles. Residents can only view their own profile; wardens can view all.
      allow read: if isAuthenticated() && (isOwner(userId) || isWarden());

      // Users can only create their own profile upon registration.
      // Crucial: Users CANNOT arbitrarily promote themselves to warden (must be 'resident', or supply valid warden verification)
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        (request.resource.data.role == 'resident' || 
         (request.resource.data.role == 'warden' && request.resource.data.wardenCode == 'WARDEN2026'));

      // Users can update their own details (e.g. phone), but CANNOT change their role to warden.
      // Only wardens can change roles or modify another user's room allocation.
      allow update: if isAuthenticated() && 
        (isWarden() || (isOwner(userId) && request.resource.data.role == resource.data.role));

      // Only wardens can delete a user record
      allow delete: if isWarden();
    }

    // Maintenance Tickets
    match /tickets/{ticketId} {
      // Residents can only read their own tickets; wardens can read all tickets
      allow read: if isAuthenticated() && 
        (resource.data.residentId == request.auth.uid || isWarden());
      
      // Residents can only create tickets tied to their own UID and starting with 'Open' status
      allow create: if isAuthenticated() && 
        request.resource.data.residentId == request.auth.uid &&
        request.resource.data.status == 'Open';
      
      // Residents can only modify their own open tickets without changing the status to Resolved or modifying warden notes.
      // Wardens have full authorization to update status (Open -> In Progress -> Resolved) and add technician notes.
      allow update: if isWarden() || 
        (isAuthenticated() && 
         resource.data.residentId == request.auth.uid && 
         resource.data.status == 'Open' &&
         request.resource.data.status == 'Open');
      
      // Only wardens can delete maintenance tickets
      allow delete: if isWarden();
    }

    // Mess Menu
    match /mess_menu/{menuDoc} {
      // All authenticated residents and wardens can view the mess menu
      allow read: if isAuthenticated();
      // Only authorized wardens can modify or publish the mess menu
      allow write: if isWarden();
    }

    // Rooms & Allocations
    match /rooms/{roomId} {
      // All authenticated residents can view room allocations
      allow read: if isAuthenticated();
      // Only wardens can allocate, reassign or edit rooms
      allow write: if isWarden();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isWarden();
    }
  }
}
