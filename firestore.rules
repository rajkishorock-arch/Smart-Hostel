rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if current user matches document user
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user has warden role
    function isWarden() {
      return isAuthenticated() && 
        (request.auth.token.role == 'warden' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'warden');
    }

    // User profiles
    match /users/{userId} {
      // Anyone can create their own profile upon registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Users can read and update their own profile; wardens can read and update room allocations for any user
      allow read: if isOwner(userId) || isWarden();
      allow update: if isOwner(userId) || isWarden();
      allow delete: if isWarden();
    }

    // Maintenance Tickets
    match /tickets/{ticketId} {
      // Residents can read their own tickets; wardens can read all tickets
      allow read: if isAuthenticated() && 
        (resource.data.residentId == request.auth.uid || isWarden());
      
      // Residents can create tickets tied to their own UID
      allow create: if isAuthenticated() && 
        request.resource.data.residentId == request.auth.uid;
      
      // Residents can only cancel/update their own open ticket; Wardens can update status and remarks
      allow update: if isWarden() || 
        (isAuthenticated() && resource.data.residentId == request.auth.uid && resource.data.status == 'Open');
      
      allow delete: if isWarden();
    }

    // Mess Menu
    match /mess_menu/{menuDoc} {
      // All authenticated residents and wardens can view the mess menu
      allow read: if isAuthenticated();
      // Only authorized wardens can modify or publish the mess menu
      allow write: if isWarden();
    }

    // Rooms & Allocations
    match /rooms/{roomId} {
      // All authenticated residents can view room allocations
      allow read: if isAuthenticated();
      // Only wardens can allocate, reassign or edit rooms
      allow write: if isWarden();
    }

    // System audit logs / announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isWarden();
    }
  }
}
