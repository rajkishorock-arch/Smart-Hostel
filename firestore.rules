rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isWarden() {
      return isAuthenticated() && 
        (request.auth.token.role == 'warden' || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'warden'));
    }

    // 1. User Profiles Collection
    match /users/{userId} {
      // Unauthenticated users cannot read profiles.
      // Residents can only view their own profile; wardens can view all profiles.
      allow read: if isAuthenticated() && (isOwner(userId) || isWarden());

      // Public registration: Users can only create their OWN document, and role MUST be 'resident'.
      // Public users CANNOT create a document with role == 'warden'.
      allow create: if isAuthenticated() && 
        request.auth.uid == userId &&
        request.resource.data.role == 'resident' &&
        request.resource.data.uid == userId;

      // Profile updates:
      // - Normal user: can update contact info, but CANNOT change role or UID.
      // - Warden: authorized to modify roles or room assignments.
      allow update: if isAuthenticated() && 
        (isWarden() || (isOwner(userId) && 
          request.resource.data.role == resource.data.role &&
          request.resource.data.uid == resource.data.uid));

      // Only wardens can delete user records
      allow delete: if isWarden();
    }

    // 2. Maintenance Tickets Collection
    match /tickets/{ticketId} {
      // Residents can read only tickets where residentId == auth.uid; wardens can read all tickets
      allow read: if isAuthenticated() && 
        (resource.data.residentId == request.auth.uid || isWarden());
      
      // Residents can only create tickets where residentId == auth.uid and initial status == 'Open'
      allow create: if isAuthenticated() && 
        request.resource.data.residentId == request.auth.uid &&
        request.resource.data.status == 'Open';
      
      // Status & Resolution updates:
      // - Residents CANNOT mark tickets as 'Resolved' or 'In Progress' and cannot change wardenNotes.
      // - Only wardens can update status to 'In Progress' or 'Resolved' and attach resolution notes.
      allow update: if isWarden() || 
        (isAuthenticated() && 
         resource.data.residentId == request.auth.uid && 
         request.resource.data.residentId == resource.data.residentId &&
         resource.data.status == 'Open' &&
         request.resource.data.status == 'Open' &&
         (!('wardenNotes' in request.resource.data) || request.resource.data.wardenNotes == resource.data.wardenNotes));
      
      // Only wardens can delete tickets
      allow delete: if isWarden();
    }

    // 3. Mess Menu Collection
    match /mess_menu/{menuDoc} {
      // Any authenticated user can read published mess menu
      allow read: if isAuthenticated();
      // ONLY Wardens can modify or publish mess menu
      allow write: if isWarden();
    }

    // 4. Rooms Collection
    match /rooms/{roomId} {
      // Any authenticated user can read room occupancy
      allow read: if isAuthenticated();
      // ONLY Wardens can allocate or edit rooms
      allow write: if isWarden();
    }

    // 5. Default Deny All Other Collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
